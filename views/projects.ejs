<%- include('partials/header') %>
<h1><%= title %></h1>

<% if (user && user.role_name === 'admin') { %>
  <a href="/new-project" style="display: inline-block; margin-bottom: 20px; padding: 10px 20px; background: #007bff; color: white; border-radius: 5px; text-decoration: none;">+ Add New Project</a>
<% } %>

<% if (projects && projects.length > 0) { %>
  <div style="display: grid; gap: 20px;">
    <% projects.forEach(project => { %>
      <div style="background: #f8f9fa; border-left: 5px solid #007bff; border-radius: 8px; padding: 20px; box-shadow: 2px 2px 5px rgba(0,0,0,0.1);">
        <p style="font-size: 1.1rem; margin: 0;">
          <strong><%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>: 
          <a href="/project/<%= project.project_id %>"><%= project.title %></a></strong> 
          (<em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em>)
        </p>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p>No projects found.</p>
<% } %>
<%- include('partials/footer') %>