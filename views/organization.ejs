<%- include('partials/header') %>
<h1><%= organization.name %></h1>

<% if (user && user.role_name === 'admin') { %>
  <a href="/edit-organization/<%= organization.organization_id %>" style="display: inline-block; margin-bottom: 20px; padding: 10px 20px; background: #28a745; color: white; border-radius: 5px; text-decoration: none;">✏️ Edit Organization</a>
<% } %>

<div style="background: #f8f9fa; border-left: 5px solid #007bff; border-radius: 8px; padding: 20px; box-shadow: 2px 2px 5px rgba(0,0,0,0.1);">
  <p><strong>Description:</strong> <%= organization.description %></p>
  <p><strong>Contact:</strong> <%= organization.contact_email %></p>
</div>

<h2>Service Projects</h2>
<% if (projects && projects.length > 0) { %>
  <ul>
    <% projects.forEach(project => { %>
      <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No service projects found for this organization.</p>
<% } %>
<%- include('partials/footer') %>