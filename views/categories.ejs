<%- include('partials/header') %>
<h1><%= title %></h1>

<a href="/new-category" style="display: inline-block; margin-bottom: 20px; padding: 10px 20px; background: #007bff; color: white; border-radius: 5px; text-decoration: none;">+ Add New Category</a>

<% if (categories && categories.length > 0) { %>
  <ul>
    <% categories.forEach(category => { %>
      <li><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No categories found.</p>
<% } %>
<%- include('partials/footer') %>