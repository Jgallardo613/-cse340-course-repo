<%- include('partials/header') %>
<h1><%= title %></h1>

<div style="background: #f8f9fa; border-left: 5px solid #007bff; border-radius: 8px; padding: 20px; box-shadow: 2px 2px 5px rgba(0,0,0,0.1); max-width: 600px;">
  <form action="/edit-project/<%= project.project_id %>" method="POST">

    <div style="margin-bottom: 15px;">
      <label for="title"><strong>Title:</strong></label><br>
      <input type="text" id="title" name="title" value="<%= project.title %>"
        style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div style="margin-bottom: 15px;">
      <label for="description"><strong>Description:</strong></label><br>
      <textarea id="description" name="description" rows="4"
        style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;"><%= project.description %></textarea>
    </div>

    <div style="margin-bottom: 15px;">
      <label for="location"><strong>Location:</strong></label><br>
      <input type="text" id="location" name="location" value="<%= project.location %>"
        style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div style="margin-bottom: 15px;">
      <label for="date"><strong>Date:</strong></label><br>
      <input type="date" id="date" name="date"
        value="<%= new Date(project.project_date).toISOString().split('T')[0] %>"
        style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div style="margin-bottom: 15px;">
      <label for="organizationId"><strong>Organization:</strong></label><br>
      <select id="organizationId" name="organizationId"
        style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;">
        <% organizations.forEach(org => { %>
          <option value="<%= org.organization_id %>"
            <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
            <%= org.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <button type="submit"
      style="padding: 10px 20px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer;">
      Update Project
    </button>
    <a href="/project/<%= project.project_id %>"
      style="margin-left: 10px; color: #6c757d;">Cancel</a>

  </form>
</div>
<%- include('partials/footer') %>
