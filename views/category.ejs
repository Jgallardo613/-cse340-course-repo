<%- include('partials/header') %>
<h1><%= category.name %></h1>

<% if (user && user.role_name === 'admin') { %>
  <a href="/edit-category/<%= category.category_id %>" style="display: inline-block; margin-bottom: 20px; padding: 10px 20px; background: #28a745; color: white; border-radius: 5px; text-decoration: none;">✏️ Edit Category</a>
<% } %>

<% if (projects && projects.length > 0) { %>
  <ul>
    <% projects.forEach(project => { %>
      <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
    <% }); %>
  </ul>
<% } else { %>
  <p>No service projects found for this category.</p>
<% } %>
<%- include('partials/footer') %>